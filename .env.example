DB_URL=jdbc:postgresql://localhost:5432/finquery
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
POSTGRES_DB=finquery

# LLM Configuration (default: gemini | local: ollama)
LLM_DEFAULT_PROVIDER=gemini
LLM_CONNECT_TIMEOUT=3s
LLM_READ_TIMEOUT=30s
LLM_MAX_OUTPUT_TOKENS=1024

# Gemini API (Production / Verification)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Ollama (Local Development — 로컬 사용 시 OLLAMA_ENABLED=true, LLM_DEFAULT_PROVIDER=ollama)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
